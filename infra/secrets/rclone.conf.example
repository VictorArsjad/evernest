# Template for infra/secrets/rclone.conf — DO NOT commit the real file.
#
# The backup sidecar mounts this at /root/.config/rclone/rclone.conf (read-only)
# and pushes an ENCRYPTED copy of each dump to Google Drive. Generate the real
# config on any machine with a browser, then copy it to the host:
#
#   1. rclone config
#        n) new remote → name: gdrive → storage: drive (Google Drive)
#           accept the defaults; complete the browser OAuth; scope: drive
#        n) new remote → name: gdrive-crypt → storage: crypt
#           remote:            gdrive:evernest      (folder to encrypt into)
#           filename_encryption: standard           (encrypts file NAMES too)
#           password:          <a strong passphrase — KEEP IT; it's the only
#                                way to decrypt your backups>
#   2. Copy the generated rclone.conf here as infra/secrets/rclone.conf
#   3. Set RCLONE_REMOTE=gdrive-crypt: in .env
#      (crypt remote already targets gdrive:evernest)
#
# Google Drive gives 15 GB free with no credit card. Dumps are tiny (well under
# 100 MB), so that's effectively unlimited headroom here. To swap providers
# later (MEGA / pCloud / Koofr — all free, no card, rclone-native), create a
# different remote and change RCLONE_REMOTE; nothing else changes.
#
# The blocks below are ILLUSTRATIVE ONLY — real values come from `rclone config`.

[gdrive]
type = drive
scope = drive
token = {"access_token":"REDACTED","refresh_token":"REDACTED","expiry":"..."}

[gdrive-crypt]
type = crypt
remote = gdrive:evernest
filename_encryption = standard
directory_name_encryption = true
# Obscured passphrase produced by `rclone config` — not the plaintext.
password = REDACTED
